<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.pentaho</groupId>
    <artifactId>third-party-libraries</artifactId>
    <version>1.0.2</version>
  </parent>

  <groupId>org.pentaho.hadoop</groupId>
  <artifactId>pentaho-shaded-netty</artifactId>
  <version>${revision}</version>
  <packaging>jar</packaging>

  <name>Pentaho Shaded Netty</name>
  <description>
    Maintained, patched Netty implementation with package relocation for HBase compatibility.
    This artifact replaces Apache HBase's shaded Netty while preserving the namespace expected by HBase clients.
    
    Package relocation: io.netty.* -> org.apache.hadoop.hbase.thirdparty.io.netty.*
    
    The embedded Netty version is explicitly managed here so each security update produces a new,
    traceable pentaho-shaded-netty release while preserving HBase client compatibility.
  </description>

  <properties>
    <netty.version>4.1.138.Final</netty.version>
    <revision>${netty.version}-pentaho-1</revision>
    <junit.jupiter.version>5.10.2</junit.jupiter.version>
    <maven.surefire.version>3.2.5</maven.surefire.version>
  </properties>

  <dependencies>
    <!-- Single fat JAR containing all Netty modules -->
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-all</artifactId>
      <version>${netty.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.jupiter.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Run the embedded-Netty security guards -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven.surefire.version}</version>
      </plugin>

      <!-- Maven Shade Plugin - Creates the shaded JAR with package relocation -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <!-- Don't create dependency-reduced-pom.xml -->
              <createDependencyReducedPom>true</createDependencyReducedPom>

              <!-- Include all classes from all netty modules -->
              <artifactSet>
                <includes>
                  <include>io.netty:*</include>
                </includes>
              </artifactSet>

              <!-- Package relocation rules -->
              <relocations>
                <relocation>
                  <!-- Relocate all io.netty.* classes -->
                  <pattern>io.netty</pattern>
                  <shadedPattern>org.apache.hbase.thirdparty.io.netty</shadedPattern>
                </relocation>
              </relocations>

              <!-- Transformer configurations -->
              <transformers>
                <!-- Merge service files (META-INF/services/*) -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>

                <!-- Add manifest entries -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <manifestEntries>
                    <Implementation-Title>${project.name}</Implementation-Title>
                    <Implementation-Version>${project.version}</Implementation-Version>
                    <Implementation-Vendor>Pentaho</Implementation-Vendor>
                    <Shaded-Netty-Version>${netty.version}</Shaded-Netty-Version>
                  </manifestEntries>
                </transformer>
              </transformers>

              <!-- Filtering -->
              <filters>
                <filter>
                  <artifact>io.netty:netty-all</artifact>
                  <excludes>
                    <!-- Exclude signature files -->
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Generate sources JAR for IDE integration -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
